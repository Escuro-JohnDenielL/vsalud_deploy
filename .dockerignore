# Dependencies
node_modules
vendor

# Environment & config files
.env
.env.*

# Vite dev-server marker: must never ship (it points @vite at localhost:5173)
public/hot
public/build/hot

# Logs & debug output
*.log
npm-debug.log
yarn-error.log

# IDE/editor settings
.DS_Store
.idea
.vscode

# Git
.git
.gitignore

# Apache rewrite rules. The Railway image runs `php artisan serve`, which has no
# .htaccess support: leaving the file in public/ just lets anyone read it via
# GET /.htaccess. The file stays in the repo for Apache/mXAMPP deployments.
public/.htaccess
